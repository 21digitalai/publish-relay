{
  "name": "publish-relay",
  "version": "0.1.64",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "publish-relay": "dist/entrypoints/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:production": "node dist/database/migrate.js",
    "dev:web": "tsx watch src/entrypoints/web.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:ui": "vite",
    "build": "tsc -p tsconfig.build.json && prettier --ignore-path /dev/null --write dist/entrypoints/cli.js && cmp src/modules/api/assets/publish-relay-cli.js dist/entrypoints/cli.js && mkdir -p dist/modules/api/assets && cp src/modules/api/assets/publish-relay-cli.js dist/modules/api/assets/publish-relay-cli.js && vite build && cp src/ui/favicon.svg dist/ui/favicon.svg",
    "package:hosted": "node scripts/package-hosted-core.mjs",
    "start:web": "node dist/entrypoints/web.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "promote:instagram-login": "node dist/entrypoints/promote-instagram-login.js",
    "cli": "tsx src/entrypoints/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:all": "playwright test && playwright test tests/e2e/magic-link.spec.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.6",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "twitter-text": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/twitter-text": "^3.1.10",
    "@vitejs/plugin-react": "^5.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
