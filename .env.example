NODE_ENV=development
DATABASE_URL=postgresql://publish_relay:change-me@127.0.0.1:5432/publish_relay
# Required by the production worker. Use a distinct login granted publish_relay_worker.
WORKER_DATABASE_URL=postgresql://publish_relay_worker_login:change-me@127.0.0.1:5432/publish_relay
# Deployment tooling only; never expose this URL to web or worker systemd units.
MIGRATION_DATABASE_URL=postgresql://publish_relay_migrator_login:change-me@127.0.0.1:5432/publish_relay
HOST=127.0.0.1
PORT=3106
WORKER_POLL_INTERVAL_MS=1000
# Omit MEDIA_RETENTION_DAYS to retain media forever. Set a neutral self-hosted duration to enable cleanup.
MEDIA_RETENTION_DAYS=
MEDIA_RETENTION_CLEANUP_INTERVAL_MS=60000
MEDIA_RETENTION_RETRY_DELAY_MS=300000
MEDIA_RETENTION_STALE_CLAIM_MS=900000
MEDIA_RETENTION_BATCH_SIZE=100
CURSOR_SIGNING_SECRET=
PUBLISH_RELAY_PUBLIC_ORIGIN=https://publish.example.com
PUBLISH_RELAY_MEDIA_STORAGE_ROOT=/var/lib/publish-relay/media
PUBLISH_RELAY_MASTER_KEY_ACTIVE_VERSION=
PUBLISH_RELAY_MASTER_KEY_V1=
PUBLISH_RELAY_X_CONSUMER_KEY=
PUBLISH_RELAY_X_CONSUMER_SECRET=
PUBLISH_RELAY_GOOGLE_CLIENT_ID=
PUBLISH_RELAY_GOOGLE_CLIENT_SECRET=
