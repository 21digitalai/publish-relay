# Candidate fragment for the approved DuckDNS origin. Merge the global options at
# the top of the operator-owned Caddyfile, then include the site block only after
# the operator confirms the existing Mobile API route remains unchanged and the
# exact hostname resolves to the Droplet.
{
	storage file_system /data/caddy
}

https://publish-relay.duckdns.org {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3106
	header {
		-Server
		Cache-Control "no-store"
	}
}
