NODE_ENV=development
DATABASE_URL=postgresql://publish_relay_web_login:change-me@127.0.0.1:5432/publish_relay
# Required by the production worker. Use a distinct login granted publish_relay_worker.
WORKER_DATABASE_URL=postgresql://publish_relay_worker_login:change-me@127.0.0.1:5432/publish_relay
# Deployment tooling only; never expose this URL to web or worker systemd units.
MIGRATION_DATABASE_URL=postgresql://publish_relay_migrator_login:change-me@127.0.0.1:5432/publish_relay
HOST=127.0.0.1
PORT=3106
WORKER_POLL_INTERVAL_MS=1000
# Omit MEDIA_RETENTION_DAYS to retain media forever. Uncomment with a neutral self-hosted duration to enable cleanup.
# MEDIA_RETENTION_DAYS=30
MEDIA_RETENTION_CLEANUP_INTERVAL_MS=60000
MEDIA_RETENTION_RETRY_DELAY_MS=300000
MEDIA_RETENTION_STALE_CLAIM_MS=900000
MEDIA_RETENTION_BATCH_SIZE=100
# Generate with: openssl rand -hex 32
CURSOR_SIGNING_SECRET=
PUBLISH_RELAY_PUBLIC_ORIGIN=http://127.0.0.1:3106
# Default is password. Magic-link mode requires the three values below in production.
# PUBLISH_RELAY_HUMAN_AUTH_MODE=magic_link
# PUBLISH_RELAY_MAGIC_LINK_PEPPER=
# PUBLISH_RELAY_RESEND_API_KEY=
# PUBLISH_RELAY_AUTH_EMAIL_FROM=
MEDIA_STORAGE_ROOT=./var/media
# Generate with: printf 'V1\n'; openssl rand -base64 32
PUBLISH_RELAY_MASTER_KEY_ACTIVE_VERSION=V1
PUBLISH_RELAY_MASTER_KEY_V1=
# Providers are optional. Keep both variables unset to leave X disabled.
# PUBLISH_RELAY_X_CONSUMER_KEY=
# PUBLISH_RELAY_X_CONSUMER_SECRET=
# YouTube is also optional; uncomment and configure both values together.
# PUBLISH_RELAY_GOOGLE_CLIENT_ID=
# PUBLISH_RELAY_GOOGLE_CLIENT_SECRET=
# PUBLISH_RELAY_LINKEDIN_CLIENT_ID=
# PUBLISH_RELAY_LINKEDIN_CLIENT_SECRET=
# Meta is optional. Enabling it requires a dedicated app pair and pinned Graph version.
# PUBLISH_RELAY_META_APP_ID=
# PUBLISH_RELAY_META_APP_SECRET=
# PUBLISH_RELAY_INSTAGRAM_APP_ID=856816254187944
# PUBLISH_RELAY_INSTAGRAM_APP_SECRET=
# PUBLISH_RELAY_META_GRAPH_VERSION=v23.0
# Enable each grant only after its exact scope set and app support are verified:
# PUBLISH_RELAY_META_FACEBOOK_PAGES_PERMISSIONS=pages_show_list,pages_read_engagement,pages_manage_posts
